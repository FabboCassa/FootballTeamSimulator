# Root .gitattributes — macro definitions MUST live here (top-level only).
# Used by client/.gitattributes (Unity template).
[attr]lfs               filter=lfs diff=lfs merge=lfs -text
[attr]unity-json        eol=lf linguist-language=json
[attr]unity-yaml        merge=unityyamlmerge eol=lf linguist-language=yaml

# .NET / general
*.cs        text diff=csharp
*.csproj    text
*.sln       text
*.md        text
*.json      text
*.yml       text
*.sh        text eol=lf
*.ps1       text eol=crlf
