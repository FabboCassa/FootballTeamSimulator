<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Phase 9.6 load generator. Deliberately dependency-free (HttpClient + System.Text.Json are in the
    framework) and deliberately OUTSIDE FootballTeamSimulator.sln: it is a tool, not part of the shipped
    server, and `dotnet test` on the solution should never build or run it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Fts.LoadTest</RootNamespace>
    <AssemblyName>fts-loadtest</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

</Project>
