# Production environment for docker-compose.prod.yml (Roadmap 10.4).
#
#   cp .env.prod.example .env.prod
#   <fill every value below>
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# .env.prod is GITIGNORED and must stay that way: it is the whole security of the deployment in one file.
# Back it up wherever the release keystore lives, not in the repository.
#
# Generate each secret with 32+ random bytes, e.g.
#   PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
#   Linux/mac : openssl rand -base64 48

# ---- the public name ---------------------------------------------------------------------------
# Must already resolve (A/AAAA) to this host, and 80/443 must be reachable, or Let's Encrypt cannot
# issue the certificate.
FTS_DOMAIN=api.example.com
FTS_ACME_EMAIL=ops@example.com

# ---- database ----------------------------------------------------------------------------------
POSTGRES_DB=fts
POSTGRES_USER=fts
POSTGRES_PASSWORD=CHANGE_ME_long_random_password

# ---- secrets -----------------------------------------------------------------------------------
# Signs every access/refresh token. Changing it invalidates every token in the wild (players get logged
# out once); leaving the shipped dev default in place lets anyone mint an admin token. >= 32 bytes.
JWT_SIGNING_KEY=CHANGE_ME_at_least_32_bytes_of_random

# Salts the hashed address/device fingerprints behind the 9.5 multi-account heuristics. Rotating it makes
# every fingerprint recorded before uncorrelatable with the ones after - which is the point: it is what
# you rotate if the database ever leaks.
INTEGRITY_SIGNAL_SALT=CHANGE_ME_random_salt

# ---- live ops ----------------------------------------------------------------------------------
# An ALREADY-REGISTERED account that is granted the admin role at startup (idempotent, logged). Register
# it through the game first, then set it here - this is the only way the first admin comes to exist on a
# fresh deployment. Leave empty once the role has been granted and a second admin exists.
ADMIN_BOOTSTRAP_EMAIL=

# ---- browser clients -------------------------------------------------------------------------------
# The origin of the hosted WebGL build / the public account-deletion page / the admin dashboard. Native
# clients send no Origin and do not need this. Empty = no CORS headers at all.
WEB_ORIGIN=https://footballteamsimulator.pages.dev

# ---- push notifications ----------------------------------------------------------------------------
# Mount the Firebase service-account key at server/secrets/fcm.json (gitignored, never in the image);
# the compose file mounts that directory read-only at /run/secrets.
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=/run/secrets/fcm.json

# ---- image tag -------------------------------------------------------------------------------------
# Tag the image with the release being deployed (tools/version.json) so a rollback is `docker compose up`
# with the previous value rather than a rebuild from a guessed commit.
FTS_VERSION=latest
