# ===== Secrets =====
# Firebase service-account keys and any other server secrets — never commit these.
server/secrets/

# Release signing (Roadmap 10.2): the Android keystore passwords and any keystore file
# that ends up in the tree. tools/keystore.local.example.ps1 IS committed as a template.
tools/keystore.local.ps1
*.keystore
*.jks
*.mobileprovision
*.p12

# ===== .NET =====
bin/
obj/
*.user
.vs/
.idea/
*.DotSettings.user

# ===== Unity (client/) =====
client/[Ll]ibrary/
client/[Tt]emp/
client/[Oo]bj/
client/[Bb]uild/
client/[Bb]uilds/
client/[Ll]ogs/
client/[Uu]serSettings/
client/[Mm]emoryCaptures/
client/[Rr]ecordings/
client/Assets/AssetStoreTools*
client/Assets/Plugins/SimCore/*.dll
client/Assets/Plugins/SimCore/*.pdb
client/*.csproj
client/*.sln
client/crashlytics-build.properties

# Unity meta files for the generated DLLs are kept (stable GUIDs)
!client/Assets/Plugins/SimCore/*.dll.meta
!client/Assets/Plugins/SimCore/*.pdb.meta

# ===== OS =====
.DS_Store
Thumbs.db
desktop.ini

# ===== Live ops (Roadmap 10.3) =====
# Database archives from tools/backup-db.ps1. Never in the repo - they are the whole database.
backups/

# ===== Deployment (Roadmap 10.4) =====
# The production environment file: database password, JWT signing key, integrity salt. The
# .env.prod.example TEMPLATE is committed; a filled-in one never is.
server/.env.prod
server/.env
.env.prod

# ===== Build/test output =====
# `dotnet test > test-output.txt` and friends. This is UTF-16 build noise, 66 MB of it, and it was
# committed once by accident in 9.5 - it is in the history now (it compresses well, so the repo is
# still small), but it does not need to be there again.
test-output.txt
*-output.txt
