# ===== Secrets =====
# Firebase service-account keys and any other server secrets — never commit these.
server/secrets/

# Release signing (Roadmap 10.2): the Android keystore passwords and any keystore file
# that ends up in the tree. tools/keystore.local.example.ps1 IS committed as a template.
tools/keystore.local.ps1
*.keystore
*.jks
*.mobileprovision
*.p12

# ===== .NET =====
bin/
obj/
*.user
.vs/
.idea/
*.DotSettings.user

# ===== Unity (client/) =====
client/[Ll]ibrary/
client/[Tt]emp/
client/[Oo]bj/
client/[Bb]uild/
client/[Bb]uilds/
client/[Ll]ogs/
client/[Uu]serSettings/
client/[Mm]emoryCaptures/
client/[Rr]ecordings/
client/Assets/AssetStoreTools*
client/Assets/Plugins/SimCore/*.dll
client/Assets/Plugins/SimCore/*.pdb
client/*.csproj
client/*.sln
client/crashlytics-build.properties

# Unity meta files for the generated DLLs are kept (stable GUIDs)
!client/Assets/Plugins/SimCore/*.dll.meta
!client/Assets/Plugins/SimCore/*.pdb.meta

